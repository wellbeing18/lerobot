                <mxCell id="step_detail_title" value="EACH DENOISING STEP IN DETAIL" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="150" y="370" width="300" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="step_1" value="1. Embed noisy trajectory:&#xa;   action_emb = action_in_proj(x_t)&#xa;   Linear(12 → 768)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=3" parent="1" vertex="1">
                    <mxGeometry x="70" y="405" width="240" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="step_2" value="2. Embed timestep:&#xa;   time_emb = sinusoidal_encoding(t)&#xa;   Shape: 768" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=3" parent="1" vertex="1">
                    <mxGeometry x="320" y="405" width="240" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="step_3" value="3. Combine action + time:&#xa;   action_time = MLP([action_emb, time_emb])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=3" parent="1" vertex="1">
                    <mxGeometry x="70" y="470" width="240" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="step_4" value="4. Cross-attend to KV cache:&#xa;   output = CrossAttention(action_time, K, V)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=3" parent="1" vertex="1">
                    <mxGeometry x="320" y="470" width="240" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="step_5" value="5. Project to velocity:&#xa;   v_t = action_out_proj(output)&#xa;   Linear(768 → 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=3" parent="1" vertex="1">
                    <mxGeometry x="70" y="525" width="240" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="step_6" value="6. Update trajectory:&#xa;   x_{t+1} = x_t + (-0.1) × v_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=3;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="320" y="525" width="240" height="55" as="geometry"/>
                </mxCell>
